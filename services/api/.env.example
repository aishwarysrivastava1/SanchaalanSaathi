# ═══════════════════════════════════════════════════════════════════════════════
#  Sanchaalan Saathi API — environment
#  Copy to `.env` for local dev. In production set these in the Railway UI.
#  NEVER commit a filled-in .env.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────────────────────────
DEPLOYMENT_ENV=development          # development | staging | production
LOG_LEVEL=INFO

# Which service modules this process serves.
#   all                       -> everything in one process (start here)
#   identity                  -> only /api/auth
#   coordination,field        -> only the NGO + volunteer APIs
#   realtime                  -> only the WebSocket gateway
# Splitting is an env-var change, not a code change.
SERVICES=all

# Uvicorn worker processes. 2 is right for a 512MB Railway container.
WEB_CONCURRENCY=2

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 chars. Changing it invalidates every issued token, signing out
# every user, so treat it as permanent once you have real traffic.
JWT_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars

ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# Your deployed frontend origin. Without it, the browser blocks every API call.
FRONTEND_URL=http://localhost:3000
# Extra allowed origins, comma-separated (preview deploys, custom domains).
ALLOWED_ORIGINS=

# ── PostgreSQL (REQUIRED) ─────────────────────────────────────────────────────
# Supabase gives you two connection strings. Both matter:
#   port 6543 = transaction pooler -> use for the APP (DATABASE_URL below)
#   port 5432 = direct             -> use for MIGRATIONS (alembic)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Or supply the parts individually instead of DATABASE_URL:
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Keep the pool small: Supabase's free tier allows very few connections, and
# every worker process opens its own pool (pool_size x WEB_CONCURRENCY).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── Redis (REQUIRED IN PRODUCTION) ────────────────────────────────────────────
# Without Redis the app still runs, but realtime events, rate limits and live
# locations become per-process — so a second replica silently breaks them.
# Upstash free tier is plenty. Use the rediss:// (TLS) URL.
REDIS_URL=

# ── AI (Google Gemini) ────────────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEM_KEY=                            # legacy alias; takes precedence if both set

# ── Neo4j AuraDB ──────────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://xxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Firebase (service account JSON on ONE line) ───────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Optional integrations ─────────────────────────────────────────────────────
GEOAPIFY_API_KEY=                   # route previews; falls back to haversine

# ── Observability ─────────────────────────────────────────────────────────────
# Guards GET /metrics. Leave blank only if the service is not internet-facing.
METRICS_TOKEN=

# ── Feature flags & limits ────────────────────────────────────────────────────
ENABLE_GUEST_MODE=true
ENABLE_DYNAMIC_REASSIGNMENT=true
LOCATION_CACHE_TTL_SECONDS=120

USER_DAILY_TOKEN_LIMIT=20000
GLOBAL_TPM_LIMIT=50000

# Abuse limits. Guest signup writes ~35 DB rows per call and needs no login,
# so keep this low unless you enjoy paying for someone else's demo clicks.
GUEST_SIGNUPS_PER_HOUR_PER_IP=3
AUTH_ATTEMPTS_PER_MINUTE_PER_IP=10
CHATBOT_REQUESTS_PER_MINUTE_PER_USER=12
