# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* variables reach the browser AND are baked in at BUILD time.
# Set them in Vercel -> Project -> Settings -> Environment Variables BEFORE
# deploying; changing one afterwards requires a redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend (REQUIRED) ────────────────────────────────────────────────────────
# Your Railway backend URL. Needed at build time (next.config.js rewrites) and
# at runtime (the realtime WebSocket connects to it directly).
# Every HTTP call is proxied through Next.js, so the browser never goes cross-origin.
NEXT_PUBLIC_BACKEND_URL=https://your-backend.up.railway.app

# ── Firebase client SDK (REQUIRED — public by design) ────────────────────────
# Used only for Google sign-in. Firebase Console -> Project Settings -> Your Apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── Google Maps (optional) ────────────────────────────────────────────────────
# Without it every page still works; only the volunteer map stays blank.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Local only ────────────────────────────────────────────────────────────────
# Set to 1 to run the production env check outside Vercel.
ENFORCE_ENV_VALIDATION=
